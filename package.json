{
  "name": "tier-table",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run tests/domain tests/store/local.test.ts",
    "test:rules": "firebase emulators:exec --project demo-tier-table --only firestore 'vitest run tests/store/rules.test.ts'",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e:firebase": "firebase emulators:exec --project demo-tier-table --only firestore,auth \"TEST_FIREBASE=true playwright test --config playwright.firebase.config.ts\"",
    "format": "prettier --write src tests *.ts",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "budoux": "^0.9.3",
    "firebase": "^13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "firebase-tools": "^15.33.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
